<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hh</groupId>
    <artifactId>ai-agent-scaffold</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>ai-agent-scaffold-api</module>
        <module>ai-agent-scaffold-application</module>
        <module>ai-agent-scaffold-app</module>
        <module>ai-agent-scaffold-domain</module>
        <module>ai-agent-scaffold-trigger</module>
        <module>ai-agent-scaffold-infrastructure</module>
        <module>ai-agent-scaffold-types</module>
        <module>ai-agent-scaffold-adk-web</module>
    </modules>

    <repositories>
        <repository>
            <id>nexus-aliyun</id>
            <name>nexus-aliyun</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
        <wrench.version>3.0.0</wrench.version>
        <google.adk.version>1.7.0</google.adk.version>
        <langchain4j.version>1.12.2</langchain4j.version>
        <jjwt.version>0.12.3</jjwt.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <guava.version>32.1.3-jre</guava.version>
        <archunit.version>1.4.2</archunit.version>
        <minio.version>8.5.17</minio.version>
    </properties>


    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
    </parent>

    <dependencyManagement>
        <dependencies>

            <!-- 扳手工程 -->
            <dependency>
                <groupId>cn.bugstack.wrench</groupId>
                <artifactId>xfg-wrench-starter-design-framework</artifactId>
                <version>${wrench.version}</version>
            </dependency>

            <!-- AI相关 -->
            <!-- ADK -->
            <dependency>
                <groupId>com.google.adk</groupId>
                <artifactId>google-adk</artifactId>
                <version>${google.adk.version}</version>
            </dependency>

            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-open-ai</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>

            <dependency>
                <groupId>com.google.adk</groupId>
                <artifactId>google-adk-langchain4j</artifactId>
                <version>${google.adk.version}</version>
            </dependency>

            <!-- JWT 仅在基础设施认证适配器中使用，application 只依赖 JwtTokenPort。 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- ADK Web 仅由独立开发模块在 adk-web Profile 下引入，不进入默认生产依赖。 -->
            <dependency>
                <groupId>com.google.adk</groupId>
                <artifactId>google-adk-dev</artifactId>
                <version>${google.adk.version}</version>
            </dependency>

            <!-- 数据库相关 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 杂项 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <!-- S3 兼容对象存储客户端仅由 infrastructure 的附件适配器使用。 -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!-- 与 ADK 的 docker-java 依赖对齐，避免 MinIO 的旧传递版本破坏收敛检查。 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.82</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.28.0</version>
            </dependency>

            <!-- 工程模块 -->
            <dependency>
                <groupId>com.hh</groupId>
                <artifactId>ai-agent-scaffold-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hh</groupId>
                <artifactId>ai-agent-scaffold-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hh</groupId>
                <artifactId>ai-agent-scaffold-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hh</groupId>
                <artifactId>ai-agent-scaffold-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hh</groupId>
                <artifactId>ai-agent-scaffold-types</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hh</groupId>
                <artifactId>ai-agent-scaffold-trigger</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- 编译目标和运行 JDK 都限定为 Java 17，避免使用更高版本 JDK 误发布。 -->
                                <requireJavaVersion>
                                    <version>[17,18)</version>
                                </requireJavaVersion>
                                <!-- Wrapper 固定 3.9.12；该下限仍允许当前开发环境的 3.8.1 完成迁移。 -->
                                <requireMavenVersion>
                                    <version>[3.8.1,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence>
                                    <excludes>
                                        <!--
                                            ADK 1.7.0 仍同时传递多代 Google Cloud Client；升级其中任一版本
                                            需要随 ADK 版本整体验证，不能在构建治理中单独强制覆盖。
                                        -->
                                        <exclude>com.google.*:*</exclude>
                                        <exclude>io.grpc:*</exclude>
                                        <exclude>org.apache.arrow:*</exclude>
                                        <exclude>com.squareup.okhttp3:*</exclude>
                                        <exclude>org.checkerframework:*</exclude>
                                        <exclude>commons-io:*</exclude>
                                        <exclude>org.codehaus.mojo:animal-sniffer-annotations</exclude>
                                        <exclude>org.apache.httpcomponents:*</exclude>
                                        <exclude>org.threeten:*</exclude>
                                        <!--
                                            OPS-01 引入的 Boot OTel bridge 使用 semconv 1.25 alpha，
                                            ADK 的 Google Cloud Storage 链使用 1.29 alpha；两者均由上游
                                            锁定，待升级 ADK/Boot 时应重新验证并移除此单坐标例外。
                                        -->
                                        <exclude>io.opentelemetry.semconv:opentelemetry-semconv</exclude>
                                    </excludes>
                                </dependencyConvergence>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>adk-web</id>
            <modules>
                <!-- 开发调试模块只在显式 Profile 中加入 Reactor，不参与默认生产构建。 -->
                <module>ai-agent-scaffold-adk-web</module>
            </modules>
        </profile>
    </profiles>

</project>
